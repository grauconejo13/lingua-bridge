# Copy to .env and fill in. Never commit .env.

# Which speech/translation provider the server uses.
#   mock   — no network calls, no key needed. Returns clearly labeled placeholder text.
#   openai — real transcription, translation and speech via the OpenAI API.
PROVIDER=mock

# Required when PROVIDER=openai. Stays on the server; never sent to the browser.
OPENAI_API_KEY=

# Optional model overrides for the openai provider.
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# OPENAI_TRANSLATE_MODEL=gpt-4o-mini
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy

# Server
PORT=8787
HOST=127.0.0.1
LOG_LEVEL=info

# Cost and abuse controls
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW=1 minute
MAX_AUDIO_BYTES=5242880
MAX_TTS_CHARS=800

# Only needed when the web app is served from a different origin than the API.
# CORS_ORIGIN=https://example.com

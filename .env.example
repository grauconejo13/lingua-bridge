# Copy to .env and fill in. Never commit .env.

# Which speech/translation provider the server uses.
#   mock   — no network calls, no key needed. Returns clearly labeled placeholder text.
#   openai — real transcription, translation and speech via the OpenAI API.
PROVIDER=mock

# Required when PROVIDER=openai. Stays on the server; never sent to the browser.
OPENAI_API_KEY=

# Optional model overrides for the openai provider.
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# OPENAI_TRANSLATE_MODEL=gpt-4o-mini
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy

# Server
PORT=8787
HOST=127.0.0.1
LOG_LEVEL=info

# Cost and abuse controls
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=1 minute
MAX_AUDIO_BYTES=5242880
MAX_TTS_CHARS=800

# Spending cap and operator page (see docs/DEPLOYMENT.md). Estimates only; also set a
# hard limit in your provider's dashboard.
DAILY_BUDGET_USD=5
# USAGE_FILE=./data/usage.json
# ADMIN_TOKEN=  (at least 24 characters, e.g. openssl rand -base64 32)

# Two-device conversations (in memory only; a restart ends them)
MAX_ROOMS=100
ROOM_IDLE_MINUTES=30

# Presentations (in memory only). Translation runs once per language in use, never per
# listener, so TALK_MAX_LANGUAGES is the cost control; listeners past it read the original.
MAX_TALKS=20
TALK_IDLE_MINUTES=60
TALK_MAX_LISTENERS=300
TALK_MAX_LANGUAGES=6

# Demo provider only: add a delay so the UI's waiting states are visible.
# MOCK_LATENCY_MS=600

# Only needed when the web app is served from a different origin than the API (for example
# a Vercel frontend; see docs/DEPLOYMENT.md). Comma-separate several origins.
# CORS_ORIGIN=https://lingua-bridge.vercel.app
